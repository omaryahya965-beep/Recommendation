# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
venv/
.venv/
env/
backend/venv/

# Environment / secrets (keep *.example files tracked)
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local
*.pem

# Node
node_modules/
frontend/node_modules/

# Next.js / build / cache
.next/
frontend/.next/
out/
dist/
build/
.cache/
*.tsbuildinfo

# Django / local databases
backend/media/
backend/staticfiles/
*.sqlite3
db.sqlite3

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE / editor temporary files
.idea/
*.swp
*.swo
*~

# OS temporary files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# E2E (Playwright) artifacts and the local E2E backend's uploads
backend/.e2e-media/
frontend/.next-e2e/
frontend/playwright-report/
frontend/test-results/
frontend/e2e/.auth/

# QA / fix-run reports and evidence: kept locally, never committed
QA-*.md
FIX*.md
EXTERNAL-QA.md
CLEANUP.md
QA-EVIDENCE/

# Test artifacts: screenshots, traces, videos, coverage, DB dumps.
# No image snapshot baselines in the repo: tests use DOM assertions and
# screenshots are written outside the repository.
*-snapshots/
__screenshots__/
*.trace.zip
*.webm
coverage/
.coverage
htmlcov/
*.dump
