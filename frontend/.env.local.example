# Local development. On Vercel this MUST be the deployed backend origin
# with no trailing slash, e.g. https://your-api.vercel.app
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# One-click demo sign-in on the login page. OFF unless set; never enable in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_DEMO_PASSWORD=Demo@12345
