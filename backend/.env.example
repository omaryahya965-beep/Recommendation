# ---------------------------------------------------------------------------
# Local development (user-space Postgres instance on port 5433 — see README)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres@localhost:5433/audit_tracker
DB_SSL_REQUIRE=False
DEBUG=True
SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# Neon (staging/production) — same code, only this file changes.
# Use the POOLED connection string (-pooler host) for the running app and the
# DIRECT connection string when running `manage.py migrate`.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://<user>:<password>@<your-neon-host>.neon.tech/audit_tracker?sslmode=require
# DB_SSL_REQUIRE=True
# DEBUG=False
# SECRET_KEY=<generate a long random value>

# Optional
# TIME_ZONE=Asia/Gaza
# MAX_UPLOAD_SIZE_MB=20
# SIMILARITY_BACKEND=auto        # auto | sbert | hashing_ngram
# SIMILARITY_THRESHOLD=0.85
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# CSRF_TRUSTED_ORIGINS=http://localhost:3000
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Media (production / Vercel) — Cloudinary. Leave unset locally.
# Does not persist on serverless without credentials. See DEPLOY.md.
# Prefer CLOUDINARY_URL; the three-part form is equivalent.
# ---------------------------------------------------------------------------
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# AI intelligence layer (server-side only — never expose AI_API_KEY to the frontend)
# ---------------------------------------------------------------------------
# local = data-driven heuristics + existing embeddings (works offline, used in tests)
# openai = OpenAI-compatible Chat Completions; falls back to local on failure
AI_ENABLED=true
AI_PROVIDER=local
AI_MODEL=heuristic-v1
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_MODEL=
AI_SIMILARITY_THRESHOLD=0.80
AI_MAX_CONTEXT_ITEMS=10
AI_MAX_OUTPUT_TOKENS=2000
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30
