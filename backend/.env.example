# ---------------------------------------------------------------------------
# Local development — NOT Neon.
# Uses the user-space Postgres instance started by scripts/start_db.ps1
# (port 5433, database audit_tracker). This file is never pointed at a Neon
# project. Production DATABASE_URL lives on the Vercel backend project.
# See README and DEPLOY.md ("Local vs Production databases").
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres@localhost:5433/audit_tracker
DB_SSL_REQUIRE=False
DEBUG=True
SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# Production Neon (Vercel-managed) — do not uncomment these into local .env.
# For migrate / createsuperuser against production, pull the exact values from
# Vercel (`vercel env pull` into a temp file, or the dashboard). Prefer
# DATABASE_URL_UNPOOLED (no -pooler in the host) for those one-shot commands.
# Do not copy connection strings by hand from the Neon console — that project
# may not be the one wired to Vercel.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://<user>:<password>@<your-neon-host>.neon.tech/audit_tracker?sslmode=require
# DB_SSL_REQUIRE=True
# DEBUG=False
# SECRET_KEY=<generate a long random value>

# Optional
# TIME_ZONE=Asia/Gaza
# MAX_UPLOAD_SIZE_MB=20
# SIMILARITY_BACKEND=auto        # auto | sbert | hashing_ngram
# SIMILARITY_THRESHOLD=0.85
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# CSRF_TRUSTED_ORIGINS=http://localhost:3000
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Media (production / Vercel) — Cloudinary. Leave unset locally.
# Does not persist on serverless without credentials. See DEPLOY.md.
# Prefer CLOUDINARY_URL; the three-part form is equivalent.
# ---------------------------------------------------------------------------
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# AI intelligence layer (server-side only — never expose AI_API_KEY to the frontend)
# ---------------------------------------------------------------------------
# local = data-driven heuristics + existing embeddings (works offline, used in tests)
# openai = OpenAI-compatible Chat Completions; falls back to local on failure
AI_ENABLED=true
AI_PROVIDER=local
AI_MODEL=heuristic-v1
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_MODEL=
AI_SIMILARITY_THRESHOLD=0.80
AI_MAX_CONTEXT_ITEMS=10
AI_MAX_OUTPUT_TOKENS=2000
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30
